---
import {checkString, type Schema} from "../../public/ts/Utilities.ts";
import Question from "./Question.astro";
import AutotestResult from "./AutotestResult.astro";

interface Props {
    autotests: Schema
}

const {autotests} = Astro.props;

---

<form class="autotest">
    {
        autotests.questions?.map((dat, i) =>
                <Question
                        title={dat.question}
                        answers={dat.answers}
                        question_number={i}
                        question_type={dat.type}
                        points={dat.points}/>
        )
    }
    <button class="autotest__submit btn btn--contrast" id="autotest__submit">Vyhodnotit</button>
    <script type="text/javascript" src=`${import.meta.env.BASE_URL}js/autotest.js` defer/>
</form>
<AutotestResult title={autotests.title}/>