---
import {renderMath} from "../../public/ts/Utilities.ts";

interface Answer {
    char: string,
    text: string
}

interface Props {
    title: string,
    question_number: number,
    answers: Answer[]
}

const {title, answers, question_number} = Astro.props;
---

<fieldset class="close-question">
    <legend set:html={renderMath((question_number + 1) + ".) " + title)}
            class="close-question__title">
    </legend>
    {
        answers.map((answer, i) =>
                <label for=`question_${question_number}_${i}` class="answer">
                    <span>{answer.char + ")"}</span>
                    <input type="radio" id=`question_${question_number}_${i}`
                           set:html={renderMath(answer.text)}
                           name=`question_${question_number}` class="answer__input"/>
                </label>
        )
    }
</fieldset>