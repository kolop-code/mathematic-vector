---

import list from "../../public/content/hero-banner/list.json"
import Card from "./Card.astro";

---

<div class="hero-banner">
    <h2 class="hero-banner__title u-center">Matematika pro střední školy</h2>
    <ul class="hero-banner__list">
        <li class="u-center">Všechny materiály na jednom místě</li>
        <li class="u-center">Možnost ověření znalostí autotesty</li>
    </ul>
    <div class="hero-banner__grid">
        {
            list.map((object, i) =>
                <Card title={object.title}
                      descriptions={object.description}
                      tags={object.tags}
                      href={object.href}
                      />
            )
        }
    </div>
</div>