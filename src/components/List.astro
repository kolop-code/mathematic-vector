---
import {getCollection} from "astro:content";

class Section {
    topic_name!: string;
    data!: { title: string, order: number, id: string }[];
    order!: number

    constructor() {
        this.data = [];
    }
}

const topics = await getCollection("topics");

let data: Section[] = [];

for (let topic1 of topics) {
    const parts1 = topic1.id.split("/");
    if (parts1.length > 1) continue;
    const topic_name = parts1[0];

    let section = new Section();
    section.topic_name = topic1.data.title;
    section.order = topic1.data.order;

    for (let topic2 of topics) {
        const parts2 = topic2.id.split("/");
        if (parts2.length == 1) continue;
        if (parts2[0] === topic_name) {
            const d = {title: topic2.data.title, order: topic2.data.order, id: topic2.id}
            section.data.push(d);
        }
    }

    data.push(section);
}

function sortData() {
    data.sort((a, b) => a.order - b.order);
    for (let section of data) {
        section.data.sort((a, b) => a.order - b.order);
    }
}

sortData()

---

<div class="list">
    {data.map((item, i) =>
            <details class="list__card" open>
                <summary class="list__card-title">{(i + 1) + ". " + item.topic_name}</summary>
                <div class="list__container">
                    {item.data.map((value, j) =>
                            <a class="list__card-subtitle action-btn"
                            href=`${import.meta.env.BASE_URL}topics/${value.id}/`
                            >{(i + 1) + "." + (j + 1) + ". " + value.title}</a>
                    )}
                </div>
            </details>
    )}
</div>
